# Proyecto T — environment template. `cp .env.example .env && ./scripts/gen-secrets.sh`.
# gen-secrets.sh replaces every CHANGE_ME_* placeholder; the placeholders are invalid, so
# both APIs fail fast when it is skipped. Never commit .env; this file is the tracked copy.

# ---- shared by both APIs ----------------------------------------------------
# development | production. Enables stack traces and the HSTS toggles.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# HS256 signing key, >= 32 bytes. Written by scripts/gen-secrets.sh.
JWT_SECRET=CHANGE_ME_run_scripts_gen-secrets.sh
# `iss` claim written by qr-api and required by both verifiers.
JWT_ISSUER=qr-api
# Access-token lifetime (Go duration).
JWT_TTL=1h
# Trust X-Forwarded-* from the immediate proxy, for the real client IP in rate limits and
# logs. false locally, true behind Cloud Run's front end.
TRUST_PROXY=false

# ---- qr-api (Go + Fiber), which reads these names verbatim ------------------
PORT=8080
# `aud` minted by qr-api; each service requires its own name (see STATS_JWT_AUDIENCE).
JWT_AUDIENCE=qr-api,stats-api
# Client-credentials identity used by the web login and docs/requests.http.
AUTH_CLIENT_ID=demo-client
# SHA-256 (hex) of the demo secret; the plaintext goes only to .env.demo-credentials.
AUTH_CLIENT_SECRET_SHA256=CHANGE_ME_run_scripts_gen-secrets.sh
# Exposes POST /api/v1/auth/demo-token (no credentials) so the SPA can run without a secret.
DEMO_TOKEN_ENABLED=true
# stats-api as seen from qr-api: the compose service name, or localhost:3000 on the host.
STATS_API_BASE_URL=http://stats-api:3000
# Per-attempt timeout of the outbound call to stats-api (Go duration).
STATS_API_TIMEOUT=5s
# Extra idempotent retries after the first attempt (1 => at most 2 attempts).
STATS_API_RETRIES=1
# Deadline for one POST /api/v1/qr, shared by the decomposition, the stats call and its
# retry. Must be >= TIMEOUT x (1 + RETRIES) = 10s, or the retry never runs, and <= the
# server's 15s write timeout, or the client never sees the 504.
REQUEST_BUDGET=12s
# Input matrix bounds. See "Limit derivation" at the bottom of this file.
MAX_MATRIX_ROWS=100
MAX_MATRIX_COLS=100
# Request body limit in bytes, 1 MiB -> 413.
MAX_BODY_BYTES=1048576
# Per-IP requests per window on /api/v1/*. The counter is in process memory, so the quota
# is per instance: with max_instances=3 the service allows up to 3x this.
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m
# Stricter limit for POST /api/v1/auth/token (per IP, same window).
AUTH_RATE_LIMIT_MAX=10
# Comma-separated allow-list, no wildcard. 8081 = web behind nginx, 5173 = Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
# Grace period for in-flight requests on SIGTERM (Go duration).
SHUTDOWN_TIMEOUT=10s

# ---- stats-api (Node + Express) ---------------------------------------------
# stats-api reads the PLAIN names PORT, JWT_AUDIENCE, CORS_ALLOWED_ORIGINS, MAX_BODY_BYTES,
# RATE_LIMIT_MAX and RATE_LIMIT_WINDOW_MS; the STATS_* aliases below let one .env feed both
# services, and docker-compose.yml maps STATS_X -> X for this container only.
STATS_PORT=3000
# Audience stats-api requires in the incoming token (-> JWT_AUDIENCE).
STATS_JWT_AUDIENCE=stats-api
# Hybrid diagonal tolerance: tol = max(absolute, relative * max|a_ij|).
DIAGONAL_ABS_TOLERANCE=1e-12
DIAGONAL_REL_TOLERANCE=1e-9
# Matrices per request -> 422 too_many_matrices.
MAX_MATRICES=8
# Sum of rows*cols across all matrices -> 422 too_many_elements.
MAX_TOTAL_ELEMENTS=100000
# Body limit in bytes, 4 MiB -> 413 (-> MAX_BODY_BYTES in the container).
STATS_MAX_BODY_BYTES=4194304
# In-memory and per instance, like qr-api's (-> RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS).
STATS_RATE_LIMIT_MAX=120
STATS_RATE_LIMIT_WINDOW_MS=60000
# Node counterpart of SHUTDOWN_TIMEOUT, in ms. Read under this plain name, so no prefix.
SHUTDOWN_TIMEOUT_MS=10000
# The browser calls stats-api directly ("recompute in Node") (-> CORS_ALLOWED_ORIGINS).
STATS_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# ---- web (React + Vite, served by nginx) ------------------------------------
# Resolved by the BROWSER, so they must be reachable from the host (never http://qr-api:8080).
# The nginx entrypoint bakes them into config.js as window.__APP_CONFIG__ at container start.
QR_API_BASE_URL=http://localhost:8080
STATS_API_BASE_URL_PUBLIC=http://localhost:3000
# Build-time overrides for `npm run dev` only; in the container window.__APP_CONFIG__ wins.
# VITE_QR_API_BASE_URL=http://localhost:8080
# VITE_STATS_API_BASE_URL=http://localhost:3000

# ---- Limit derivation (ADR-0014) --------------------------------------------
# qr-api takes at most 100 x 100 = 10 000 numbers, ~1 MiB of JSON, hence MAX_BODY_BYTES.
# Its output [Q, R] is 20 000 numbers, ~0.5 MiB, so stats-api needs a larger limit: 4 MiB
# leaves ~8x headroom and still bounds memory. MAX_TOTAL_ELEMENTS bounds CPU independently
# of byte size, and 8 x 100 x 100 = 80 000 <= 100 000, so with these defaults
# too_many_elements is unreachable: each matrix is validated before elements are summed, so
# 8 x 200x200 is rejected as too_many_rows. It starts firing once the row, column or matrix
# caps are raised without it — MAX_MATRIX_ROWS=MAX_MATRIX_COLS=200 gives 320 000 elements.
