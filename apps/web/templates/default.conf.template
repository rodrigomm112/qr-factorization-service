# Proyecto T — web (nginx-unprivileged). 20-envsubst-on-templates.sh substitutes only the env
# vars that are defined ($uri and friends survive): that is how the API origins reach the CSP.

# A map, not a per-location `add_header`: a nested add_header REPLACES every inherited header,
# which is how a route silently loses the CSP.
map $uri $app_cache_control_by_path {
    default        "no-cache";
    "/config.js"   "no-store";
    "~^/assets/"   "public, max-age=31536000, immutable";
    "~^/fonts/"    "public, max-age=31536000, immutable";
}

# `add_header ... always` fires on errors too, so only 2xx (and the 304 of a conditional
# request) keep the path policy: a 404 for a hashed bundle must not be cached as `immutable`.
map $status $app_cache_control {
    default   "no-store";
    "~^2"     $app_cache_control_by_path;
    "304"     $app_cache_control_by_path;
}

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;
    charset      utf-8;

    server_tokens off;

    # -- Security headers ------------------------------------------------------
    # The browser talks to both APIs directly, hence the two origins in `connect-src`. No
    # 'unsafe-inline' anywhere: the build emits no inline script (modulePreload.polyfill is off).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${QR_API_BASE_URL} ${STATS_API_BASE_URL}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    # Ignored by the browser over the plain http of local dev; in production Cloud Run
    # terminates TLS and this pins the origin to https for a year.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Cache-Control $app_cache_control always;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   6;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/manifest+json image/svg+xml font/otf;

    location / {
        try_files $uri /index.html;
    }

    # A miss must 404, not fall back to index.html with a 200 and "Unexpected token '<'".
    # That 404 is `no-store` (see the $status map), so a deploy race cannot pin it for a year.
    location /assets/ {
        try_files $uri =404;
    }

    location /fonts/ {
        types { font/otf otf; }
        try_files $uri =404;
    }

    location = /config.js {
        default_type application/javascript;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; try_files $uri =204; }
}
