# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yaml,yml,json,jsonc,ts,tsx,js,jsx,mjs,cjs,css,html,md}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 4

[*.{tf,tfvars}]
indent_style = space
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2
